@model DashboardMetrics
@{
    ViewData["Title"] = "Overview";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Operations snapshot</p>
        <h1>Fitness center overview</h1>
        <p>Live totals read from the current SQL Server sample database.</p>
    </div>
</header>

<section class="metric-grid" aria-label="Database totals">
    <article class="metric-card">
        <span>Total members</span>
        <strong>@Model.TotalMembers</strong>
        <a asp-action="Members">View member plans</a>
    </article>
    <article class="metric-card">
        <span>Active memberships</span>
        <strong>@Model.ActiveMemberships</strong>
        <a asp-action="Members">Review statuses</a>
    </article>
    <article class="metric-card">
        <span>Class schedules</span>
        <strong>@Model.ScheduledClasses</strong>
        <a asp-action="Classes">See trainers and rooms</a>
    </article>
    <article class="metric-card">
        <span>Recorded check-ins</span>
        <strong>@Model.TotalCheckIns</strong>
        <a asp-action="Attendance">Review attendance</a>
    </article>
    <article class="metric-card">
        <span>Private sessions</span>
        <strong>@Model.PrivateSessions</strong>
        <a asp-action="Sessions">View session schedule</a>
    </article>
    <article class="metric-card">
        <span>Payments</span>
        <strong>@Model.Payments</strong>
        <a asp-action="Payments">Review payments</a>
    </article>
</section>
