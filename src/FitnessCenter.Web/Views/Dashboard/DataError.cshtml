@model DataErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="state-card">
    <p class="eyebrow">Connection problem</p>
    <h1>@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="button button-primary"
       asp-controller="Dashboard"
       asp-action="@Model.RetryAction">
        Try again
    </a>
</section>
